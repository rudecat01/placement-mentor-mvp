{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "../dist/shared",
    "rootDir": "."
  },
  "include": ["types/**/*.ts", "constants/**/*.ts"],
  "exclude": ["node_modules", "../dist"]
}
